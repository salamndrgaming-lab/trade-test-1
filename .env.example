# ── Coin Trader — copy to .env on the server. NEVER commit .env. ──

# shadow (default) = real quotes, nothing ever signed or sent. live = real money.
TRADING_MODE=shadow

# HTTP API (bound to localhost; reached only through cloudflared)
BOT_HOST=127.0.0.1
BOT_PORT=8787

# Phase 1: serve mock /state from the bot (true) or the real pipeline (later phases)
MOCK_STATE=true

# ── Filled in from later phases ──
