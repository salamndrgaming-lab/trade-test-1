{
  "name": "coin-trader",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @coin/bot --filter @coin/web dev",
    "dev:web": "pnpm --filter @coin/web dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @coin/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "secret-scan": "node scripts/secret-scan.mjs --all",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
