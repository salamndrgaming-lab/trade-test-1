{
  "name": "@coin/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "record": "tsx src/record.ts",
    "dev:stack": "tsx watch --env-file-if-exists=.env src/index.ts"
  },
  "dependencies": {
    "@coin/shared": "workspace:*",
    "@fastify/cors": "11.3.1",
    "@noble/curves": "2.4.0",
    "better-sqlite3": "13.0.3",
    "bs58": "6.0.0",
    "fastify": "5.12.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
