# ── Coin Trader bot. Copy to apps/bot/.env (local) or /etc/coin-trader/bot.env (server). NEVER commit .env. ──

# shadow (default) = real data and quotes, nothing is ever signed or sent. live = real money (phase 5 only).
TRADING_MODE=shadow
NODE_ENV=production

# HTTP API, bound to localhost and reached only through cloudflared
BOT_HOST=127.0.0.1
BOT_PORT=8787
# The dashboard's origin, if it calls the API cross-origin (e.g. https://coin-trader.pages.dev)
ALLOWED_ORIGIN=

# live | record (live + save responses as test fixtures). "fixtures" replay is refused in production.
DATA_SOURCE=live
DB_PATH=data/coin-trader.sqlite

# Any Solana mainnet RPC. If it has an API key in the URL, the bot never logs it.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter API key from https://developers.jup.ag/portal (free plan: 1 req/s). Empty = keyless (0.5 req/s).
JUPITER_API_KEY=

# The bot wallet's PUBLIC key: balance and ticket size (2%). The private key is not used before phase 4.
BOT_WALLET_PUBKEY=
# Only if BOT_WALLET_PUBKEY is empty: ticket size (SOL) used for chain_kill quotes
QUOTE_TICKET_SOL=

# Pipeline cadence
TICK_SECONDS=60
RECHECK_MINUTES=5
WATCH_HOURS=3
# Count holders with getProgramAccounts (heavy; many public RPCs refuse it)
HOLDERS_VIA_GPA=false

# ── AI (phase 3). Fallback order: Workers AI → Groq → Gemini → rules only (no picks, no new trades). ──
# Cloudflare Workers AI (free: 10,000 neurons per UTC day). Token needs the "Workers AI: Read" permission.
CF_ACCOUNT_ID=
CF_WORKERS_AI_TOKEN=
WORKERS_AI_SCORE_MODEL=@cf/zai-org/glm-4.7-flash
WORKERS_AI_PICK_MODEL=@cf/openai/gpt-oss-120b
# Switch from Workers AI to Groq at this share of the daily neurons
AI_DAILY_NEURONS=10000
AI_SWITCH_AT=0.9
# Groq (free key at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Gemini (free key at aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Output caps (reasoning tokens count as output) and pacing
AI_MAX_TOKENS=300
CHIEF_MAX_TOKENS=400
AI_SCORES_PER_TICK=6
CHIEF_MIN_MINUTES=30

# ── later phases ──
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# WALLET_KEY_FILE=/etc/coin-trader/wallet.enc
# WALLET_KEY_PASSPHRASE=
