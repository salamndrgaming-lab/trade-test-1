# ── Coin Trader bot. Copy to apps/bot/.env (local) or /etc/coin-trader/bot.env (server). NEVER commit .env. ──

# shadow (default) = real data and quotes, nothing is ever signed or sent. live = real money (phase 5 only).
TRADING_MODE=shadow
NODE_ENV=production

# HTTP API, bound to localhost and reached only through cloudflared
BOT_HOST=127.0.0.1
BOT_PORT=8787
# The dashboard's origin, if it calls the API cross-origin (e.g. https://coin-trader.pages.dev)
ALLOWED_ORIGIN=

# live | record (live + save responses as test fixtures). "fixtures" replay is refused in production.
DATA_SOURCE=live
DB_PATH=data/coin-trader.sqlite

# Any Solana mainnet RPC. If it has an API key in the URL, the bot never logs it.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter API key from https://developers.jup.ag/portal (free plan: 1 req/s). Empty = keyless (0.5 req/s).
JUPITER_API_KEY=

# The bot wallet's PUBLIC key: balance and ticket size (2%). The private key is not used before phase 4.
BOT_WALLET_PUBKEY=
# Only if BOT_WALLET_PUBKEY is empty: ticket size (SOL) used for chain_kill quotes
QUOTE_TICKET_SOL=

# Pipeline cadence
TICK_SECONDS=60
RECHECK_MINUTES=5
WATCH_HOURS=3
# Count holders with getProgramAccounts (heavy; many public RPCs refuse it)
HOLDERS_VIA_GPA=false

# ── later phases ──
